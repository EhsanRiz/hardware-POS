# Copy to .env and fill in. Values come from the Supabase project (Settings > API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Shop details printed on quotes / tax invoices.
VITE_SHOP_NAME=Hardware Shop
VITE_SHOP_ADDRESS=Street address|Ladybrand, Free State
VITE_VAT_NUMBER=
VITE_VAT_RATE=0.15
VITE_CURRENCY=R

# Printed font scale (1-8x). Width narrows columns; height just makes text taller.
VITE_RECEIPT_WIDTH=48
VITE_PRINT_WIDTH_SCALE=1
VITE_PRINT_HEIGHT_SCALE=3

# Carried over from the cafe build; not used in a hardware shop. Left here so
# the tip UI can be re-enabled rather than silently losing the feature.
# VITE_TIP_PERCENTS=10,12.5,15
