# Values for the end-to-end build. Deliberately fake: the client refuses to
# start without a URL and key, and e2e/fake-backend.ts intercepts every request
# before it leaves the browser. Nothing here is a credential.
VITE_SUPABASE_URL=https://e2e.supabase.co
VITE_SUPABASE_ANON_KEY=e2e-not-a-real-key
VITE_CURRENCY=R
# The shipped default is 40 columns, and the suite must test what ships:
# pinning 48 here meant every receipt assertion was about a slip the shop
# does not print. The width is a per-device setting now (Manage > Shop >
# Printing); this is only the fallback for a device that never set one.
VITE_RECEIPT_WIDTH=40
