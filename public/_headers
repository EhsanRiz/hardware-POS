/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Vite fingerprints these, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker decides when the till updates itself. If this is cached,
# a tablet can keep running an old build indefinitely — including one with a
# bug you have already fixed. Never cache it.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/registerSW.js
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate
